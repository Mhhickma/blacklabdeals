{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "git": { "deploymentEnabled": false },
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "**/*", "use": "@vercel/static" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(best-amazon-home-kitchen-deals|best-amazon-electronics-deals|best-amazon-deals-under-50)/(.*)?",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|webp|gif|svg|ico)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(deals|best_seller_deals|amazon-sales-event-deals).json",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, max-age=0, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1.js" },
    { "src": "/deals.json", "dest": "https://raw.githubusercontent.com/Mhhickma/blacklabdeals/main/deals.json" },
    { "src": "/best_seller_deals.json", "dest": "https://raw.githubusercontent.com/Mhhickma/blacklabdeals/main/best_seller_deals.json" },
    { "src": "/amazon-sales-event-deals.json", "dest": "https://raw.githubusercontent.com/Mhhickma/blacklabdeals/main/amazon-sales-event-deals.json" },
    { "src": "/top-100-amazon-deals-today", "dest": "/top-100-amazon-deals-today/index.html" },
    { "src": "/top-100-amazon-deals-today/", "dest": "/top-100-amazon-deals-today/index.html" },
    { "src": "/best-amazon-home-kitchen-deals", "dest": "/best-amazon-home-kitchen-deals/index.html" },
    { "src": "/best-amazon-home-kitchen-deals/", "dest": "/best-amazon-home-kitchen-deals/index.html" },
    { "src": "/best-amazon-home-kitchen-deals/index.html", "dest": "/best-amazon-home-kitchen-deals/index.html" },
    { "src": "/best-amazon-electronics-deals", "dest": "/best-amazon-electronics-deals/index.html" },
    { "src": "/best-amazon-electronics-deals/", "dest": "/best-amazon-electronics-deals/index.html" },
    { "src": "/best-amazon-electronics-deals/index.html", "dest": "/best-amazon-electronics-deals/index.html" },
    { "src": "/best-amazon-tool-deals", "dest": "/best-amazon-tool-deals/index.html" },
    { "src": "/best-amazon-tool-deals/", "dest": "/best-amazon-tool-deals/index.html" },
    { "src": "/best-amazon-deals-under-50", "dest": "/best-amazon-deals-under-50/index.html" },
    { "src": "/best-amazon-deals-under-50/", "dest": "/best-amazon-deals-under-50/index.html" },
    { "src": "/best-amazon-deals-under-50/index.html", "dest": "/best-amazon-deals-under-50/index.html" },
    { "src": "/amazon-deal-event", "dest": "/amazon-deal-event/index.html" },
    { "src": "/amazon-deal-event/", "dest": "/amazon-deal-event/index.html" },
    { "src": "/amazon-electronics-deals", "dest": "/amazon-deal-event/index.html" },
